<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <include layout="@layout/layout_galaxy_bg" />

    <ImageView
        android:id="@+id/ivLivingForest"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/anim_living_forest"
        android:visibility="gone" />
        
    <com.nightread.app.ui.TextureBackgroundView
        android:id="@+id/textureBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:animateLayoutChanges="true"
        android:layout_marginLeft="@dimen/library_horizontal_margin"
        android:layout_marginRight="@dimen/library_horizontal_margin">

    <!-- Top Action Bar Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/glassHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/bg_card">

        <RelativeLayout
            android:id="@+id/layoutNormalHeader"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_menu"
                android:contentDescription="Меню"
                app:tint="@color/icon_tint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnMenu"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Библиотека"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/etSearch"
                    android:layout_width="200dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_search_input"
                    android:elevation="2dp"
                    android:visibility="gone"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@null"
                    app:queryHint="Поиск..."
                    app:searchIcon="@null"
                    app:submitBackground="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSort"
                    style="@style/HeaderIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Сортировка"
                    app:icon="@drawable/ic_action_sort"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleViewMode"
                    style="@style/HeaderIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Режим списка"
                    app:icon="@drawable/ic_action_view"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchToggle"
                    style="@style/HeaderIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Поиск"
                    app:icon="@drawable/ic_action_search"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImport"
                    style="@style/HeaderIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Импорт"
                    app:icon="@drawable/ic_action_import"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleTheme"
                    style="@style/HeaderIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Переключить тему"
                    app:icon="@drawable/ic_action_theme"
                    app:iconSize="20dp" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Selection Mode Header Panel (hidden by default) -->
        <RelativeLayout
            android:id="@+id/layoutSelectionHeader"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCloseSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_close"
                android:contentDescription="Отменить выделение"
                app:tint="@color/icon_tint" />

            <TextView
                android:id="@+id/tvSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnCloseSelection"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Выбрано: 1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Все"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSelected"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Удалить выбранное"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_action_delete"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#FF4757"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sleek Horizontal Progress Bar for Scanning Indicator -->
    <ProgressBar
        android:id="@+id/headerProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Scan Progress Status Container -->
        <include layout="@layout/scan_status_layout" />

        <!-- New Books Banner -->
        <LinearLayout
            android:id="@+id/layoutNewBooksBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_notification"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNewBooksCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Найдено новых книг: X"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnShowNewBooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Показать"
                android:textColor="#FFE3A8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" />

            <ImageView
                android:id="@+id/btnCloseNewBooks"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                app:tint="#FFE3A8" />
        </LinearLayout>

        <!-- Continue Reading Section -->
        <LinearLayout
            android:id="@+id/layoutContinueReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Продолжить чтение"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContinueReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <!-- FrameLayout for list and placeholder -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- SwipeRefreshLayout for manual rescan -->
            <include layout="@layout/layout_shimmer_library" android:visibility="gone" />
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- RecyclerView Grid of Books -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBooks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Beautiful Empty library placeholder state with illustration and call to action -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivEmptyIllustration"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:src="@drawable/ic_action_import"
                    android:contentDescription="Иллюстрация пустой библиотеки"
                    app:tint="@color/accent"
                    android:layout_marginBottom="16dp" />

                <ProgressBar
                    android:id="@+id/progressBarEmptyState"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEmptyStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Библиотека пока пустая"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvEmptyStateDesc"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:text="Начните сканирование или импортируйте книги"
                    android:textColor="#D0C8D8"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyStateScan"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_action_import"
                    app:iconTint="#FFFFFF"
                    android:text="Сканировать"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/accent"
                    android:clickable="true"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecoverLibrary"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Восстановить библиотеку"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/accent"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
