<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_glass_panel_60">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_headphones"
                    app:tint="@color/accent"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvAudiobooksTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Аудиокниги"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanAudio"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Сканировать"
                app:icon="@drawable/ic_custom_scan"
                app:cornerRadius="20dp"
                android:textSize="12sp"
                android:backgroundTint="@color/accent" />
        </RelativeLayout>

        <!-- Search Bar -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchAudiobooks"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input"
            app:iconifiedByDefault="false"
            app:queryHint="Поиск аудиокниг..." />
    </LinearLayout>

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyAudiobooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_headphones"
            app:tint="#8080A0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Аудиокниг пока нет"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Загрузите или просканируйте устройство на наличие аудиофайлов (.mp3, .m4b, .m4a, .aac, .ogg, .flac)"
            android:textColor="#A0A0C0"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Найти аудиокниги"
            app:icon="@drawable/ic_custom_scan"
            app:cornerRadius="24dp"
            android:backgroundTint="@color/accent" />
    </LinearLayout>

    <!-- Audiobooks RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAudiobooks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/layoutMiniPlayer"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Persistent Mini Player Bar -->
    <LinearLayout
        android:id="@+id/layoutMiniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bg_dark_purple_bottom_sheet"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="8dp">

        <ProgressBar
            android:id="@+id/pbMiniPlayer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="@drawable/bg_splash_progress"
            android:max="100"
            android:layout_marginBottom="8dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivMiniCover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_headphones"
                android:background="@drawable/bg_card_rounded"
                android:padding="8dp"
                app:tint="@color/accent"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/ivMiniCover"
                android:layout_toStartOf="@id/btnMiniPlayPause"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvMiniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Название аудиокниги"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvMiniAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Исполнитель / Автор"
                    android:textColor="#A0A0C0"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMiniPlayPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_media_play_custom"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/accent" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
