<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_purple_bottom_sheet"
    android:padding="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle"
        android:layout_marginBottom="16dp" />

    <!-- Cover View with Glow -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_cover_glow"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/ivPlayerCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_headphones"
            android:scaleType="centerInside"
            app:tint="@color/accent" />
    </FrameLayout>

    <!-- Title & Author -->
    <TextView
        android:id="@+id/tvPlayerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Название аудиокниги"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvPlayerAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Автор / Чтец"
        android:textColor="#A0A0C0"
        android:textSize="15sp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPlayerChapter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!-- Seekbar & Timers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <SeekBar
            android:id="@+id/seekBarAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvCurrentPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#A0A0C0"
                android:textSize="12sp"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#A0A0C0"
                android:textSize="12sp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Main Player Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeedToggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="1.0x"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSkipBackward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_media_prev_custom"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:layout_marginHorizontal="16dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPlayerPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_media_play_custom"
            app:fabSize="normal"
            app:tint="#FFFFFF"
            app:backgroundTint="@color/accent"
            app:elevation="6dp" />

        <ImageButton
            android:id="@+id/btnSkipForward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_media_next_custom"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:layout_marginHorizontal="16dp" />

        <ImageButton
            android:id="@+id/btnSleepTimer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#A0A0C0" />

        <ImageButton
            android:id="@+id/btnChapters"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#A0A0C0"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
