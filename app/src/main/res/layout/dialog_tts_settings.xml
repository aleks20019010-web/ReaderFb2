<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_purple_bottom_sheet"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle"
        android:layout_marginBottom="16dp" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_headphones"
                app:tint="@color/accent"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvTtsSettingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки озвучки (TTS)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseTts"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#A0A0B0" />
    </RelativeLayout>

    <!-- Controls Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_panel_30"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <!-- Voice Selection -->
        <TextView
            android:id="@+id/tvVoiceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Голос озвучки:"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerVoice"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_dropdown_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="16dp" />

        <!-- Speed control -->
        <TextView
            android:id="@+id/tvSpeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Скорость речи: 1.0x"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <SeekBar
            android:id="@+id/seekBarSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="25"
            android:progress="5"
            android:layout_marginBottom="16dp" />

        <!-- Pitch control -->
        <TextView
            android:id="@+id/tvPitchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Высота голоса: 1.0x"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <SeekBar
            android:id="@+id/seekBarPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="5"
            android:layout_marginBottom="16dp" />

        <!-- Continuous reading switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchContinuous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Непрерывное чтение страниц"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:checked="true" />
    </LinearLayout>

    <!-- Info Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_glass"
        android:padding="10dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_ai_info"
            app:tint="@color/accent"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Озвучка продолжается в фоновом режиме даже при заблокированном экране."
            android:textColor="#A0A0C0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTtsPlayPause"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Озвучить"
            app:icon="@drawable/ic_media_play_custom"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTtsStop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Стоп"
            app:icon="@drawable/ic_media_stop_custom"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="#FFFFFF"
            app:strokeColor="#50FFFFFF" />
    </LinearLayout>

</LinearLayout>
